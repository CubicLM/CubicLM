<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ SplashScreen API: branded splash from the first frame.
     Only attributes verified to link on this project's compileSdk are
     used (animation duration defaults to 1000ms; the activity keeps
     the manifest LaunchTheme afterwards, whose windowBackground is
     the same branded layer-list, so no flash). -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/launch_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <!-- Dark-navy icon needs a light disc behind it (same fix as
             the legacy launch_background layer-list). -->
        <item name="android:windowSplashScreenIconBackgroundColor">#F4EEE3</item>
    </style>
</resources>
