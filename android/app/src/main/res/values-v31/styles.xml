<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ SplashScreen API: parchment background (same as the
     legacy layer-list and the light Flutter splash) with the icon
     centered directly on it — no disc needed. -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/launch_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
    </style>
</resources>
