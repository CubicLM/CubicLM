<?xml version="1.0" encoding="utf-8"?>
<!-- Cold-start window: full parchment background (Dt.canvas) with the
     dark-navy icon centered — visible immediately, no disc, no black.
     Density-matched 128dp logo (transparent bg): crisp everywhere,
     no white box. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background" />
    <!-- 96dp logo, downscaled from the 128dp density asset: sharp on
          mdpi–xxxhdpi. Width/height on item needs API 23+; minSdk 28. -->
    <item
        android:width="96dp"
        android:height="96dp"
        android:gravity="center">
        <bitmap
            android:src="@drawable/splash_icon"
            android:gravity="fill" />
    </item>
</layer-list>
